{
	"name": "@marianmeres/html-extract",
	"version": "0.5.0",
	"exports": "./src/mod.ts",
	"publish": {
		"exclude": [
			".*",
			"tests/**",
			"tmp/**"
		]
	},
	"tasks": {
		"test": "deno test --allow-read --allow-env --ignore=tests/mcp tests/",
		"test:watch": "deno test --watch --allow-read --allow-env --ignore=tests/mcp tests/",
		"doc:lint": "deno doc --lint src/mod.ts && deno check --doc src/",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish",
		"test:golden": "UPDATE_GOLDEN=1 deno test --allow-read --allow-write --allow-env tests/golden.test.ts",
		"test:mcp": "deno test -A tests/mcp/"
	},
	"imports": {
		"@marianmeres/html-extract": "./src/mod.ts",
		"@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6",
		"linkedom": "npm:linkedom@^0.18.13"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve",
		"exclude": [
			"tests/fixtures",
			"docs/design.md"
		]
	},
	"lint": {
		"exclude": [
			"mcp.ts"
		]
	}
}
